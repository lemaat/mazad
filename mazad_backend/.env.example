# Copy this file to .env (or export these as real environment variables)
# and fill in real values before deploying. Local dev works without it —
# config/settings.py falls back to dev-friendly defaults when these are unset.

DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

DB_NAME=mazad_db
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
